{
  "name": "comphq",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "go build -trimpath -o bin/ ./cmd/comphq",
    "test:unit": "go vet ./... && go test ./...",
    "test:integration": "go test -tags integration ./...",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:speed": "playwright test --project=speed",
    "test:screens": "playwright test --project=screens",
    "test:policy": "go test ./tools/policy/...",
    "check": "npm run build && npm run test:unit && npm run test:integration && npm run test:policy && npm run test:e2e && npm run test:a11y",
    "vendor:editor": "node scripts/vendor-editor/build.mjs",
    "vendor:sortable": "node scripts/vendor-sortable.mjs",
    "fixtures:docx": "go run ./e2e/fixtures/docx/gen",
    "icons": "node tools/icons/render.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-file-handler": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "esbuild": "0.28.2",
    "sortablejs": "1.15.7"
  }
}
